# ============================================================================
# WeeklyClass LMS — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
#
# NOTE ON SECURITY:
# Everything prefixed with EXPO_PUBLIC_ is INLINED INTO THE CLIENT BUNDLE and is
# therefore public. That is expected and safe for Firebase Web config — those
# values are identifiers, not secrets. Your data is protected by Firestore
# Security Rules + Firebase App Check, NOT by hiding these keys.
#
# NEVER put a Firebase Admin SDK service account key in this file.
# ============================================================================

# --- Firebase Web SDK config (required) -------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase Cloud Messaging (web push) ------------------------------------
# Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# --- Expo push notifications (native) ---------------------------------------
# Your EAS project id — app.json -> expo.extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Firebase App Check (optional but recommended for production web) -------
# Google reCAPTCHA v3 site key registered under App Check for your web app.
# Leave blank in development; App Check stays disabled when this is empty.
EXPO_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=
# Set to `true` only on a local machine to use an App Check debug token.
EXPO_PUBLIC_APPCHECK_DEBUG=false

# --- Local emulator suite (optional) ----------------------------------------
# Set to `true` to point the app at the Firebase Local Emulator Suite.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_EMULATOR_HOST=localhost

# --- Seed script (scripts/seed.mjs) -----------------------------------------
# ONLY used locally by the seeding script. Never deployed, never committed.
# Path to a Firebase Admin service account JSON downloaded from:
#   Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=

# --- File uploads (optional, free) -------------------------------------------
# Firebase now requires a paid plan before Cloud Storage can be enabled, so
# in-app uploading needs somewhere else to put files. Cloudinary's free tier is
# 25 GB and needs no card.
#
#   1. Sign up at cloudinary.com
#   2. Dashboard -> copy your "Cloud name"
#   3. Settings -> Upload -> Add upload preset
#        Signing mode: Unsigned
#        (recommended) restrict Allowed formats to jpg,png,webp,pdf and set a
#        max file size, since the preset name ships inside the app
#   4. Put the cloud name and preset name below and restart the dev server
#
# Leave these blank and image fields still work — you paste a link instead.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Accounts registered without an email address (optional) ----------------
# Such accounts sign in under <mobile number>@this-domain behind the scenes.
# Leave blank for the default, mobile.weeklyclass.app. Do NOT change it once
# people have registered: their sign-in addresses were made with the old one.
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=

# --- Browser push notifications ----------------------------------------------
# A VAPID key pair. The PUBLIC half ships inside the app; the PRIVATE half is
# used only by the notification service, as the GitHub secret VAPID_PRIVATE_KEY
# (with VAPID_PUBLIC_KEY and VAPID_SUBJECT beside it).
# Make a pair once:  npx web-push generate-vapid-keys
# KEEP A PRIVATE COPY. The private key cannot be downloaded again. A new pair
# still works - devices re-subscribe on their own - see docs/NEW-COMPUTER.md.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# --- Admin-set passwords (optional) ------------------------------------------
# Make a pair once:  node scripts/make-password-key.js
# Public half here for the app; private half here AND as the GitHub secret
# PASSWORD_PRIVATE_KEY. KEEP A PRIVATE COPY - it cannot be downloaded again.
EXPO_PUBLIC_PASSWORD_PUBLIC_KEY=
PASSWORD_PRIVATE_KEY=

# --- Booking confirmation email (optional) -----------------------------------
# Any SMTP account, for example Gmail with an app password. Also add each one as
# a GitHub secret of the same name. Left blank, bookings work without email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Scripts (optional) ------------------------------------------------------
# Only needed if the Firebase Hosting site name differs from the project id.
FIREBASE_HOSTING_SITE=
