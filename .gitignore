# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds
/ios
/android
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Environment — NEVER commit real credentials
.env
.env.local
.env.*.local
# Anything else beginning .env — backups made when a key is rotated hold the
# OLD private keys, and those are exactly as dangerous as the current ones.
.env.*
!.env.example

# Firebase service accounts / admin credentials
# Firebase service account keys — these ARE secrets, unlike the web API key.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
.firebase/
firebase-debug.log
firestore-debug.log

# Build & tooling
.vercel
.turbo
coverage/
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*

# The service-account key. Never commit this — it is full admin access.
serviceAccount.json

# Service logs from the notification sender.
logs/

# Database backups contain real personal data. Never commit them.
backups/
