rules_version = '2';

// =============================================================================
// WeeklyClass LMS — Firestore Security Rules
// =============================================================================
//
// The client is never trusted. Every permission the UI checks is re-checked
// here, because hiding a button stops nobody who can call the API directly.
//
// Model
//   users/{uid}.role         'admin' | 'teacher' | 'student'
//   users/{uid}.status       must be 'active' to do anything
//   users/{uid}.permissions  map of PERMISSION -> bool (teachers only)
//   classes/{id}.teacherIds  the teachers allowed to act on that class
//
// Admins hold every permission implicitly. Teachers hold only what an admin has
// granted AND are additionally limited to their own classes. Students can read
// what is assigned to them and write only their own quiz attempts and results.
//
// Cost note: helpers below call get() on the caller's own user document. Rules
// cache repeated get() of the same path within a single evaluation, so a
// request costs one extra read regardless of how many helpers run.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identity helpers ---------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Returns an empty map rather than erroring when the caller has no profile
    // document. A rules expression that throws is treated as a denial, and a
    // missing profile is a completely normal state during first-run setup — it
    // should not turn every unrelated check into an unexplained "permission
    // denied".
    function userDoc() {
      return userExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A suspended, pending or soft-deleted account can read and write nothing.
    //
    // The comparisons below are deliberately forgiving about how the document
    // was written. The first admin has to be created by hand in the Firebase
    // console, where it is very easy to save `deleted` as the STRING "false"
    // rather than a boolean, or `role` as "Admin". A strict check turns either
    // slip into a blanket "permission denied" with nothing to explain it.
    //
    // Being lenient here costs no security: anything that is not explicitly
    // deleted counts as live, and an account is still only as privileged as the
    // role an admin gave it.
    function isDeleted() {
      return userDoc().get('deleted', false) == true
        || userDoc().get('deleted', false) == 'true';
    }

    function isActive() {
      return userExists()
        && userDoc().get('status', '').lower() == 'active'
        && !isDeleted();
    }

    function role() {
      return isActive() ? userDoc().get('role', 'none').lower() : 'none';
    }

    function isAdmin()   { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isStudent() { return role() == 'student'; }
    function isStaff()   { return isAdmin() || isTeacher(); }

    // Admins implicitly hold everything; teachers hold only granted flags.
    function can(permission) {
      return isAdmin()
        || (isTeacher() && userDoc().get('permissions', {}).get(permission, false) == true);
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Class scoping ------------------------------------------------------

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    // A teacher may only act on classes they are assigned to. Admins: any class.
    function teachesClass(classId) {
      return isAdmin()
        || (isTeacher()
            && classId != null
            && exists(/databases/$(database)/documents/classes/$(classId))
            && request.auth.uid in classDoc(classId).get('teacherIds', []));
    }

    function myClassId() {
      return isActive() ? userDoc().get('classId', null) : null;
    }

    // Content with no classId is shared with everyone.
    function inMyClassOrShared(classId) {
      return classId == null || classId == myClassId();
    }

    // --- Field-level helpers ------------------------------------------------

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(allowed) {
      return changedKeys().hasOnly(allowed);
    }

    function isSoftDeleteOnly() {
      return onlyChanged(['deleted', 'deletedAt', 'deletedBy', 'updatedAt']);
    }

    // =========================================================================
    // Public lookup indexes
    // =========================================================================
    //
    // Both are readable by `get` only, never `list`. You must already know the
    // exact username (or the SHA-256 of the email) to read a row, so neither
    // collection can be enumerated to harvest accounts.

    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();

      // Claimed by the account it names, or by an admin creating that account
      // on their behalf — an admin's own uid will never match the new user's,
      // so without this an admin simply cannot add anyone.
      allow create: if isSignedIn()
                    && (request.resource.data.uid == request.auth.uid || isAdmin());

      // An account may repair its OWN row — both before and after must name the
      // same uid, so this cannot be used to seize somebody else's username. The
      // app does this on sign-in when the index is missing or stale, which is
      // the normal state for an account created by hand in the console.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /emailLookup/{emailHash} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // First-run bootstrap
    // =========================================================================
    //
    // A brand-new project has no admin, and the rules below deliberately refuse
    // to let anyone self-register as one. Something has to break that circle.
    //
    // While `settings/bootstrap` does NOT exist, the platform is unconfigured,
    // and the first signed-in account may create its own profile with the admin
    // role. Creating that profile also creates this marker, after which the
    // allowance is gone permanently - the condition can never be true again.
    //
    // The window is only open on a database with no marker, which in practice
    // means the minute between deploying rules and the owner signing in. It
    // replaces a hand-built Firestore document, which proved far more dangerous
    // in practice: it is very easy to fumble and leaves no audit trail.
    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    match /settings/bootstrap {
      allow read: if true;
      allow create: if isSignedIn() && bootstrapOpen();
      allow update, delete: if isAdmin();
    }

    // One phone number, one account. Same shape as `usernames`: readable by
    // `get` so registration can check availability, and never listable.
    match /mobiles/{mobileKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Sequential id counters (STU-2026-0001), incremented in a transaction while
    // a user registers. This runs BEFORE users/{uid} exists, so the rule can
    // only depend on `request.auth` — any helper that reads the user document
    // would deny the very write that registration needs.
    //
    // A value-type guard used to live here. It was removed deliberately: these
    // documents hold nothing but a sequence number, the guard bought no real
    // safety, and combined with the serverTimestamp transform it was denying
    // legitimate writes. Authentication is the check that matters.
    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // =========================================================================
    // Users
    // =========================================================================

    match /users/{uid} {

      // Own profile always; staff per permission. A teacher who can view
      // students can read the collection — narrowing further would require a
      // per-document class check that Firestore cannot apply to list queries.
      allow get: if isSelf(uid)
                 || isAdmin()
                 || (isTeacher() && (can('VIEW_STUDENTS') || can('VIEW_TEACHERS')));

      allow list: if isAdmin()
                  || (isTeacher() && (can('VIEW_STUDENTS') || can('VIEW_TEACHERS')));

      // Self-registration: the account creates its own profile, and cannot
      // grant itself a role or status it should not have.
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role in ['student', 'teacher']
                    && request.resource.data.status in ['pending', 'active']
                    && request.resource.data.get('permissions', {}).keys().size() <= 40
                    // Never let a self-registration hand itself admin powers.
                    && !request.resource.data.get('permissions', {}).keys().hasAny([
                         'MANAGE_USERS', 'MANAGE_SETTINGS', 'MANAGE_BRANCHES',
                         'MANAGE_LANGUAGES', 'DELETE_STUDENTS', 'DELETE_TEACHERS'
                       ])
                    || (isAdmin() && request.resource.data.uid == uid)
                    // First-run only: see the bootstrap block above. Closes for
                    // good the moment settings/bootstrap exists.
                    || (
                      isSelf(uid)
                      && bootstrapOpen()
                      && request.resource.data.uid == uid
                      && request.resource.data.role == 'admin'
                    );

      // Editing yourself: profile fields only. Role, status and permissions are
      // deliberately excluded — that is what stops privilege escalation.
      allow update: if (
                      isSelf(uid)
                      && onlyChanged([
                           'fullName', 'mobile', 'profileImage', 'language',
                           // Per-dashboard language choices and the personal
                           // Qur'an reading plan. Both are the person's own
                           // settings: they grant nothing and are safe to let
                           // people write for themselves.
                           'dashboardLanguages', 'quranPlan',
                           'dateOfBirth', 'gender', 'qualification',
                           'pushTokens', 'lastLoginAt', 'searchTokens', 'updatedAt',
                           // Cleared by the app once a new password has been
                           // set. A prompt rather than a boundary: somebody
                           // could clear it without changing anything, and all
                           // they would gain is skipping a screen on their own
                           // account with a password they already know. An
                           // admin is the only one who can set it.
                           'mustChangePassword'
                         ])
                    )
                    // First-run only: an account that registered before any
                    // admin existed may promote itself, which closes the
                    // bootstrap window in the same flow. Impossible once
                    // settings/bootstrap exists.
                    || (
                      isSelf(uid)
                      && bootstrapOpen()
                      && request.resource.data.role == 'admin'
                      && request.resource.data.status == 'active'
                    )
                    || isAdmin()
                    || (
                      isTeacher()
                      && resource.data.role == 'student'
                      && can('EDIT_STUDENTS')
                      && !changedKeys().hasAny(['role', 'permissions', 'uid'])
                    )
                    || (
                      isTeacher()
                      && resource.data.role == 'teacher'
                      && can('EDIT_TEACHERS')
                      && !changedKeys().hasAny(['role', 'permissions', 'uid'])
                    );

      // Records are soft-deleted so attendance and results keep their subject.
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Platform configuration
    // =========================================================================

    // The splash screen needs the app name and whether registration is open
    // before anyone signs in, so this document is world-readable. It contains
    // no secrets.
    match /settings/{docId} {
      allow read: if true;
      allow write: if can('MANAGE_SETTINGS');
    }

    // A deliberately thin copy of the class schedule, written by the calendar
    // and readable by anybody — including somebody who has never signed in,
    // which is the point: the sign-in screen advertises the coming classes.
    //
    // It holds only what a poster would say. No meeting link, no class id, no
    // audience, no attendee count. Firestore grants a whole document or none of
    // it, so publishing a title while withholding a URL is not something a rule
    // can do — the field has to be absent from the document, and here it is.
    match /publicSchedule/{eventId} {
      allow read: if true;
      allow write: if can('MANAGE_CALENDAR');
    }

    match /languages/{code} {
      allow read: if true;
      allow write: if can('MANAGE_LANGUAGES');
    }

    // Countries, organisations, branches and classes are readable before login
    // because the registration form offers them as choices.
    match /countries/{id} {
      allow read: if true;
      allow write: if can('MANAGE_BRANCHES');
    }

    match /organizations/{id} {
      allow read: if true;
      allow write: if can('MANAGE_BRANCHES');
    }

    match /branches/{id} {
      allow read: if true;
      allow write: if can('MANAGE_BRANCHES');
    }

    match /classes/{classId} {
      allow read: if true;
      allow create: if can('CREATE_CLASSES');
      allow update: if can('EDIT_CLASSES')
                    && (isAdmin() || request.auth.uid in resource.data.get('teacherIds', []));
      allow delete: if can('DELETE_CLASSES');
    }

    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if can('EDIT_CLASSES');
    }

    // =========================================================================
    // Learning content
    // =========================================================================

    match /lessons/{lessonId} {
      allow read: if isStaff()
                  || (isStudent() && resource.data.classId == myClassId());

      allow create: if can('CREATE_LESSONS')
                    && teachesClass(request.resource.data.classId);

      allow update: if can('EDIT_LESSONS')
                    && teachesClass(resource.data.classId);

      // Deletion goes through a soft delete; hard delete is admin-only.
      allow update: if can('DELETE_LESSONS')
                    && teachesClass(resource.data.classId)
                    && isSoftDeleteOnly();

      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      // A guest — nobody signed in at all — may read a PUBLISHED recording that
      // belongs to no particular class. That is the shop window: somebody
      // deciding whether this platform is for them can watch what has just been
      // released without first handing over a phone number.
      //
      // Evaluated per document, so a query filtered to published shared videos
      // passes and one asking for anything wider is refused. A draft, and
      // anything scoped to a class, stays behind a sign-in.
      function isPubliclyVisible() {
        return resource.data.get('status', 'draft') == 'published'
          && resource.data.get('deleted', false) == false
          && !('classId' in resource.data.keys() && resource.data.classId != null);
      }

      allow read: if isPubliclyVisible()
                  || isStaff()
                  || (isStudent() && inMyClassOrShared(resource.data.get('classId', null)));

      allow create: if can('UPLOAD_VIDEO');
      allow update: if can('UPLOAD_VIDEO')
                    || (can('DELETE_VIDEO') && isSoftDeleteOnly());
      allow delete: if isAdmin();
    }

    /**
     * The teachers' notes on the ninety-nine names.
     *
     * Readable by anyone signed in, and by nobody else — this is the centre's
     * own teaching, not a public leaflet. Written only by whoever is trusted
     * with the rest of the written content; the same permission that governs
     * articles governs this, because it is the same act.
     *
     * Never deleted through the app. A note is replaced by editing it, and the
     * id is the name's number, so there is nothing to tidy up.
     */
    /**
     * Khutbah and bayan translations.
     *
     * Read by anyone signed in — this is the centre's own rendering of what was
     * said from its own minbar, not a public document. Written by whoever is
     * trusted with the written content, which is the same act and so the same
     * permission.
     */
    /**
     * Where a browser is reachable for a push notification.
     *
     * A subscription endpoint is a capability, not a name: anybody holding one
     * together with the private key can put a notification on that person's
     * lock screen. So nobody reads these from the app — not students, not
     * staff, not admins. Only the sender reads them, and it runs with a
     * service account outside these rules.
     *
     * A person may write their OWN, which is what registering a device is, and
     * may mark it deleted, which is what turning notifications off is. The uid
     * is checked against the document so one account cannot register a device
     * in somebody else's name and receive their notifications.
     */
    /*
     * Password reset requests.
     *
     * ADMINS ONLY, READ AND WRITE, with no exception for the person being
     * reset. A row here carries a one-time reset link, and a reset link is a
     * working credential: whoever holds it can set that account's password. It
     * is treated like one rather than like a notification.
     *
     * The worker that fills the link in runs with the Admin SDK, which bypasses
     * these rules entirely, so nothing here needs to accommodate it.
     */
    /*
     * Queued password changes.
     *
     * ADMINS ONLY. Each row holds a password sealed with a public key whose
     * private half lives only on the machine running the sender, so the value
     * here is useless to anyone who reads it — including a backup. The rule is
     * still admin-only, because who is having their password changed is itself
     * worth not publishing.
     */
    match /passwordChanges/{changeId} {
      allow read, write: if isAdmin();
    }

    match /passwordResets/{requestId} {
      allow read, write: if isAdmin();
    }

    match /pushSubscriptions/{subscriptionId} {
      allow read: if false;
      allow create, update: if isSignedIn()
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /khutbahs/{khutbahId} {
      allow read: if isSignedIn();
      allow create, update: if can('MANAGE_ARTICLES');
      allow delete: if isAdmin();
    }

    match /divineNames/{nameNumber} {
      allow read: if isSignedIn();
      allow write: if can('MANAGE_ARTICLES');
    }

    match /articles/{articleId} {
      // Same shop window as videos: a published article is readable by anybody,
      // a draft by nobody without an account. Articles carry no class scoping,
      // so being published is the whole of the test.
      allow read: if isSignedIn()
                  || (resource.data.get('status', 'draft') == 'published'
                      && resource.data.get('deleted', false) == false);
      allow write: if can('MANAGE_ARTICLES');
    }

    match /materials/{materialId} {
      allow read: if isStaff()
                  || (isStudent() && inMyClassOrShared(resource.data.get('classId', null)));

      allow create: if can('UPLOAD_MATERIAL');
      allow update: if can('UPLOAD_MATERIAL')
                    || (can('DELETE_MATERIAL') && isSoftDeleteOnly());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Calendar
    // =========================================================================

    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if can('MANAGE_CALENDAR');
      allow delete: if can('MANAGE_CALENDAR');

      // Anyone signed in may change the seat count and nothing else, because
      // booking a place has to increment it and the person booking is not an
      // organiser. The field is narrowed to exactly that one, and to a number
      // that is not negative.
      //
      // The honest limit of this rule: it cannot check the count against the
      // capacity, because that lives in a nested map and the arithmetic belongs
      // to the booking transaction. Someone determined could therefore make an
      // event look fuller or emptier than it is. That is a nuisance, not a
      // breach — no booking is created, no money moves, and an organiser can see
      // the real total by counting the registrations.
      allow update: if can('MANAGE_CALENDAR')
                    || (isSignedIn()
                        && onlyChanged(['registeredCount', 'updatedAt'])
                        && request.resource.data.registeredCount is int
                        && request.resource.data.registeredCount >= 0);
    }

    /**
     * Whether the admin has asked to review every booking by hand.
     *
     * One extra document read, on the booking-create path only. Worth it:
     * without reading the setting the rule would have to take the client's word
     * for it, which is exactly the thing a client should not be trusted about.
     */
    function bookingsNeedApproval() {
      return get(/databases/$(database)/documents/settings/app)
               .data.get('requireBookingApproval', false) == true;
    }

    /**
     * Whether the event genuinely has room for this booking right now.
     *
     * Read from the event document rather than believed from the request. The
     * client computes the same thing inside its transaction, and this is the
     * half that stops a client which simply lies about it — a booking may only
     * write itself `confirmed` if the seats it claims actually exist.
     *
     * An event with no capacity is uncapped, and uncapped means always room.
     */
    function eventHasRoom(eventId, seats) {
      let event = get(/databases/$(database)/documents/calendarEvents/$(eventId)).data;
      let capacity = event.get('registration', {}).get('capacity', null);
      return capacity == null
        || event.get('registeredCount', 0) + seats <= capacity;
    }

    // =========================================================================
    // Event bookings
    // =========================================================================
    //
    // A booking belongs to the person who made it and to whoever runs the
    // event. Students may create and read their own; only staff see the whole
    // list, which is what the attendee export is built from.

    match /eventRegistrations/{registrationId} {
      // `resource == null` FIRST, and it is not a nicety.
      //
      // The booking id is derived from the event and the person, so before a
      // booking exists the app reads that exact path to ask "have I already
      // booked?" — inside the transaction, which is the only place the question
      // can be asked safely. Reading a document that does not exist evaluates
      // `resource.data` on null, which throws, and a rule that throws is a
      // denial. So every FIRST booking was refused by its own duplicate check,
      // with no error surfaced beyond a permission failure on a read.
      //
      // Allowing the read of a missing document reveals nothing: the answer is
      // "there is nothing here", which the caller already suspected.
      allow get: if isSignedIn()
                 && (resource == null
                     || resource.data.userId == request.auth.uid
                     || isStaff());
      // Evaluated per document, so a student's query filtered to their own uid
      // passes while an unfiltered one is refused.
      allow list: if isStaff()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);

      // A booking is a request, and normally it may only ever be created
      // pending — nobody issues themselves a confirmed ticket. Nobody marks
      // their own booking paid either, whatever else is true.
      //
      // A booking may write itself `confirmed` only when the event actually has
      // room for it AND the admin has not asked to review everything. Both are
      // read from Firestore rather than taken from the request, so a client
      // that claims a seat it cannot have is refused here even though its own
      // transaction was willing.
      //
      // `pending` is always allowed: that is a request, and asking costs the
      // event nothing.
      //
      // Confirming says a place is held, not that money arrived — `paid` is a
      // separate field and no booking may set it for itself.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.seats is int
                    && request.resource.data.seats > 0
                    && request.resource.data.paid == false
                    && (request.resource.data.status == 'pending'
                        || (request.resource.data.status == 'confirmed'
                            && !bookingsNeedApproval()
                            && eventHasRoom(request.resource.data.eventId,
                                            request.resource.data.seats)));

      // Two writes share this rule, and self-cancelling is deliberately not one
      // of them.
      //
      // Once a booking is made, only staff may change it. An organiser has
      // counted the seats, laid the tables and possibly taken the money, and a
      // place given up silently at midnight is a place they find empty on the
      // night. Somebody who cannot come now asks, which is the conversation
      // that was happening anyway.
      //
      // 1. The holder books AGAIN after staff cancelled or declined. The id is
      //    derived from the event and the person, so a second booking lands on
      //    the same document and Firestore sees an update rather than a create.
      //    Without this, one cancellation locked somebody out of the event
      //    permanently. It is held to exactly the conditions a create is.
      //
      // 2. Staff confirm, decline, cancel, or record payment.
      allow update: if (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid
                        && (resource.data.status == 'cancelled'
                            || resource.data.status == 'rejected')
                        && request.resource.data.seats is int
                        && request.resource.data.seats > 0
                        && request.resource.data.paid == false
                        && (request.resource.data.status == 'pending'
                            || (request.resource.data.status == 'confirmed'
                                && !bookingsNeedApproval()
                                && eventHasRoom(request.resource.data.eventId,
                                                request.resource.data.seats))))
                    || (isStaff()
                        && !changedKeys().hasAny(['amount', 'userId', 'seats', 'participants'])
                        // A cancelled booking stays cancelled: reinstating it
                        // would hand back a seat the count has already released.
                        && resource.data.status != 'cancelled');
      // Note: a rejected booking CAN still be edited by staff, on purpose. An
      // organiser who declined by mistake, or who found room later, should be
      // able to confirm it — and confirming goes through the transaction that
      // takes the seat, so it cannot oversell.

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Attendance
    // =========================================================================

    match /attendance/{recordId} {
      // A student sees only their own record; staff see their classes.
      allow get: if (isStudent() && resource.data.studentId == request.auth.uid)
                 || (can('VIEW_ATTENDANCE') && teachesClass(resource.data.classId))
                 || isAdmin();

      allow list: if isStudent() || can('VIEW_ATTENDANCE');

      allow create, update: if can('EDIT_ATTENDANCE')
                            && teachesClass(request.resource.data.classId)
                            && request.resource.data.status in ['present', 'absent', 'late', 'excused'];

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Quizzes
    // =========================================================================

    match /quizzes/{quizId} {
      allow read: if isStaff()
                  || (isStudent() && resource.data.classId == myClassId());

      allow create: if can('CREATE_QUIZ')
                    && teachesClass(request.resource.data.classId);
      allow update: if can('EDIT_QUIZ') && teachesClass(resource.data.classId);
      allow update: if can('DELETE_QUIZ')
                    && teachesClass(resource.data.classId)
                    && isSoftDeleteOnly();
      allow delete: if isAdmin();

      // Questions: text and options only — no correct answer is stored here, so
      // a student reading them learns nothing they should not.
      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if can('CREATE_QUIZ') || can('EDIT_QUIZ');
      }

      // The answer key. A student may read it ONLY once they have a submitted
      // attempt for this quiz — which is what makes client-side grading safe
      // against reading answers in advance.
      match /answerKey/{questionId} {
        allow read: if isStaff()
                    || (
                      isStudent()
                      && hasSubmittedAttempt(quizId, request.auth.uid)
                    );
        allow write: if can('CREATE_QUIZ') || can('EDIT_QUIZ');
      }
    }

    // Attempt ids are deterministic: `{quizId}_{uid}_{n}`, so this is an
    // existence check rather than a query.
    function hasSubmittedAttempt(quizId, uid) {
      return exists(/databases/$(database)/documents/quizAttempts/$(quizId + '_' + uid + '_1'))
        && get(/databases/$(database)/documents/quizAttempts/$(quizId + '_' + uid + '_1')).data.status == 'submitted';
    }

    match /quizAttempts/{attemptId} {
      allow get: if (isSignedIn() && resource.data.studentId == request.auth.uid)
                 || can('VIEW_RESULTS')
                 || isAdmin();
      allow list: if isSignedIn();

      allow create: if isStudent()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == 'in_progress'
                    && request.resource.data.classId == myClassId();

      // Answers may be revised while in progress, and frozen on submission.
      // Once submitted the document is immutable to the student — this is what
      // prevents re-reading the key and then editing the answers.
      allow update: if isStudent()
                    && resource.data.studentId == request.auth.uid
                    && resource.data.status == 'in_progress'
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.quizId == resource.data.quizId
                    && request.resource.data.status in ['in_progress', 'submitted'];

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow get: if (isSignedIn() && resource.data.studentId == request.auth.uid)
                 || can('VIEW_RESULTS')
                 || isAdmin();
      allow list: if isSignedIn();

      // Written once by the student who owns the matching submitted attempt.
      // They cannot then edit it, and a teacher can always regrade.
      allow create: if isStudent()
                    && request.resource.data.studentId == request.auth.uid
                    && resultId == request.resource.data.attemptId
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= request.resource.data.totalMarks;

      allow update: if can('EDIT_RESULTS') || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Notifications and announcements
    // =========================================================================

    match /notifications/{notificationId} {
      allow read: if isSignedIn();

      /**
       * Two ways a notification gets created, and they are not the same act.
       *
       * A BROADCAST somebody composed — "general" or "announcement" — is a
       * message to the whole school in the organisation's voice, and stays
       * behind SEND_NOTIFICATIONS.
       *
       * An AUTOMATIC one is the tail of an action the staff member was already
       * permitted to take: they published a lesson, a recording or a reply, and
       * the people it concerns are told. Requiring a second permission for that
       * did not make anything safer — it made a teacher's every publish notify
       * nobody, silently, because the notification write was denied after the
       * lesson had already been saved and the failure was swallowed. Teachers
       * do not hold SEND_NOTIFICATIONS by default, so this was every teacher.
       *
       * The category is what separates them, and it is checked here rather than
       * trusted from the client's intent.
       */
      allow create: if can('SEND_NOTIFICATIONS')
                    || (
                      isStaff()
                      && request.resource.data.category in [
                        'class_reminder', 'new_lesson', 'new_video',
                        'quiz_available', 'quiz_closing', 'new_article',
                        'event_reminder', 'attendance_reminder', 'support_reply'
                      ]
                    );

      // Anyone signed in may mark a notification read — but only by adding
      // their own uid, nothing else about the document may change.
      allow update: if can('SEND_NOTIFICATIONS')
                    || (
                      isSignedIn()
                      && onlyChanged(['readBy'])
                      && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
                      && request.resource.data.readBy.hasOnly(
                           resource.data.get('readBy', []).concat([request.auth.uid])
                         )
                    );

      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if can('MANAGE_ANNOUNCEMENTS');
    }

    // =========================================================================
    // Support, feedback and Q&A
    // =========================================================================
    //
    // A support request is private between the person who wrote it and staff.
    // Anyone signed in may write one for themselves; only staff may read the
    // collection, and only staff may reply. The author can read their own back
    // to see the reply, which is the whole point of writing in.

    // =========================================================================
    // Private notes
    // =========================================================================
    //
    // The only collection in this file an admin cannot read. That is the whole
    // point of it: a notebook somebody's teacher can open is not a notebook,
    // and a promise of privacy kept only by the app having no screen for it is
    // not a promise. `isAdmin()` is deliberately absent from every rule here.
    //
    // Delete is soft, through an update, so the row survives a mistimed tap.
    // Hard delete is refused outright — a purge belongs to the owner's account
    // being removed, not to a stray call.
    match /notes/{noteId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Per-document, so a query filtered to the caller's own uid passes and an
      // unfiltered one is refused.
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 20000;

      // The owner cannot hand a note to somebody else by rewriting the uid.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    match /supportRequests/{requestId} {
      allow get: if isSignedIn()
                 && (resource.data.userId == request.auth.uid || isStaff());
      // Listing is staff-only. A student queries their own with a userId filter,
      // which the rule below still constrains to their own uid.
      allow list: if isStaff()
                  || (isSignedIn() && request.query.limit <= 50);

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'open'
                    // Nobody writes their own reply in.
                    && request.resource.data.reply == null
                    && request.resource.data.repliedBy == null;

      // The one exception, and the reason it has to exist: somebody locked out
      // of their account cannot sign in to ask for help with signing in. Held
      // to a fixed shape — this kind only, open, unattributed, no reply, short
      // strings — so the surface is a handful of text fields and nothing else.
      //
      // It cannot be rate-limited in rules, so junk rows are possible. They are
      // readable only by staff, they overwrite nothing, and an admin can delete
      // them; that is a smaller harm than leaving a locked-out student with no
      // way to reach anyone.
      allow create: if request.resource.data.kind == 'passwordHelp'
                    && request.resource.data.status == 'open'
                    && request.resource.data.userId == null
                    && request.resource.data.reply == null
                    && request.resource.data.repliedBy == null
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() <= 120
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 400;

      // Only staff answer or close. The author cannot edit what they sent,
      // which keeps a complaint from being rewritten after it was acted on.
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Q&A is the opposite: asked in the open so the whole class learns from the
    // answer. Readable by any signed-in member, answerable only by staff.
    match /qaQuestions/{questionId} {
      allow read: if isSignedIn();

      // Nobody posts a question with its own answer already in it. Tested by
      // VALUE, not by the key being absent: the client writes `answer: null`
      // and `answeredBy: null` so the document has a fixed shape, and a rule
      // that refused documents merely CONTAINING those keys refused every
      // question ever asked — which is why this collection was empty. The same
      // mistake was in the support request rule and was fixed there first.
      allow create: if isSignedIn()
                    && request.resource.data.askedBy == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.answer == null
                    && request.resource.data.answeredBy == null;

      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Audit log — append only
    // =========================================================================
    //
    // Any signed-in user can append (their own actions are logged by the
    // client), but nobody — admins included — can edit or remove an entry.
    // Rewriting history from a client is simply not expressible here.

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // Default deny
    // =========================================================================
    //
    // Anything not matched above is denied. New collections must be granted
    // access explicitly rather than inheriting it.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
